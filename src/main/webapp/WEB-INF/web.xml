<?xml version="1.0" encoding="UTF-8"?>
<!--
  Os servlets são mapeados com @WebServlet; este arquivo só configura
  a codificação das JSPs e as páginas de erro amigáveis.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Catálogo de Livros</display-name>

    <!-- Todas as JSPs e fragmentos (.jspf) em UTF-8, para acentos funcionarem -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <!--
      Sessão só por cookie: impede que o servidor coloque ";jsessionid=..."
      nos links. Ter o id da sessão na URL é inseguro (ele pode vazar ao
      copiar o link ou em logs).
    -->
    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!--
      Páginas de erro: em vez da página padrão do servidor (que pode mostrar
      stack trace e detalhes internos), o usuário vê uma mensagem simples.
    -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/jsp/erro.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/erro.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/erro.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/jsp/erro.jsp</location>
    </error-page>
    <!--
      Página de erro padrão (sem código): cobre qualquer outro erro HTTP,
      como 405 (método não permitido), para nunca aparecer a página do servidor.
    -->
    <error-page>
        <location>/WEB-INF/jsp/erro.jsp</location>
    </error-page>
</web-app>
